# 本地配置模板。真实配置放在 .env，启动时自动读取，无需手动 export。
# 填齐下面三个值后启用真实模型；留空时使用本地规则推理。
REPAIR_LLM_BASE_URL=https://api.deepseek.com
REPAIR_LLM_API_KEY=
REPAIR_LLM_MODEL=deepseek-flash
# auto 根据官方域名选择适配；公司网关可显式设为 deepseek 或 openai。
REPAIR_LLM_PROVIDER=auto

# Agent 工单和检查点数据库。相对路径以启动目录为基准。
REPAIR_AGENT_DB=data/repair_agent.db
# 不设置知识库路径时，默认使用 <Agent数据库>.knowledge.db。
# REPAIR_KNOWLEDGE_DB=data/repair_agent.db.knowledge.db

# 留空使用本地模拟业务后端；接入独立后端时填写 URL 和可选密钥。
REPAIR_BACKEND_BASE_URL=
REPAIR_BACKEND_API_KEY=
REPAIR_BACKEND_DB=data/repair_backend.db

# 常用长期运行配置，其余字段沿用代码默认值。
REPAIR_WORKERS=2
REPAIR_QUEUE_CAPACITY=100
REPAIR_TASK_SECONDS=120

# 日志默认按上海日期分目录；DEBUG 可用于排查。
REPAIR_LOG_DIR=logs
REPAIR_LOG_LEVEL=INFO
